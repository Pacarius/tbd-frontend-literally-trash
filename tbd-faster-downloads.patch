+func mediaFileExists(media *MediaModel) (bool, error) {
+	var tweet TweetModel
+	if err := DB.First(&tweet, "id = ?", media.TweetID).Error; err != nil {
+		return false, eris.Wrap(err, "Tweet not found for media")
+	}
+
