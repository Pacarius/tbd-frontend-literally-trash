+	if err != nil {
+		return false, err
+	}
+	var mediaCount int64
+	if err := DB.Model(&MediaModel{}).Where("tweet_id = ?", tweet.ID).Count(&mediaCount).Error; err != nil {
+		return false, eris.Wrap(err, "Failed to count tweet media")
+	}
+	filename := buildFilename(&tweet, media.Index, int(mediaCount), parsedURL)
+	info, err := os.Stat(path.Join(config.MediaDir, filename))
+	if err == nil {
+		return !info.IsDir() && info.Size() > 0, nil
+	}
+	if os.IsNotExist(err) {
+		return false, nil
+	}
+	return false, err
